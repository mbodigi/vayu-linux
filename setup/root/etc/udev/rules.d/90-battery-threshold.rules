# ThinkPad: keep the battery between 75% and 80% to slow wear (other laptops with a charge limit are left alone)
ACTION=="add|change", SUBSYSTEM=="power_supply", KERNEL=="BAT0", TEST=="/sys/devices/platform/thinkpad_acpi", ATTR{charge_control_start_threshold}="75", ATTR{charge_control_end_threshold}="80"
