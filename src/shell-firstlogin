#!/bin/sh
# First login of a user (started by mango's exec_once): settings that live in dconf, not in files.
marker="$HOME/.local/state/shell/.firstlogin-done"
[ -e "$marker" ] && exit 0

gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dark'
gsettings set org.gnome.desktop.interface icon-theme 'Fluent-grey'
gsettings set org.gnome.desktop.interface cursor-theme 'Breeze_Light'
gsettings set org.gnome.desktop.interface cursor-size 24
gsettings set org.gnome.desktop.interface font-name 'JetBrains Mono 10'
gsettings set org.gnome.desktop.interface monospace-font-name 'JetBrains Mono 11'
gsettings set org.gnome.desktop.wm.preferences button-layout 'appmenu:close'

c=io.github.celluloid-player.Celluloid
gsettings set $c always-autohide-cursor true
gsettings set $c always-use-floating-controls true
gsettings set $c draggable-video-area-enable false
gsettings set $c mpv-config-enable true
gsettings set $c mpv-config-file "file://$HOME/.config/mpv/mpv.conf"

xdg-user-dirs-update 2>/dev/null

# no wallpaper (ours aren't shipped): Fedora's default; setting it also makes the theme colors and the login screen's copy.
# The shell starts alongside this script, so wait up to 10 s for it.
wp=$(cat "$HOME/.local/state/shell/wallpaper" 2>/dev/null)
if [ ! -f "$wp" ] && [ -f /usr/share/backgrounds/default-dark.jxl ]; then
    for _ in $(seq 20); do
        qs -c shell ipc call wallpaper set /usr/share/backgrounds/default-dark.jxl 2>/dev/null && break
        sleep 0.5
    done
fi
touch "$marker"
